<!doctype html>
<html lang="pt-BR">

<head>
  <meta charset="utf-8">
  <title>Editar Produto</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>

<body>
  <div class="admin-layout">
    <aside class="sidebar">
      <h2>Admin</h2>
      <nav>
        <a href="/admin">Dashboard</a>
        <a href="/admin/products" class="active">Produtos</a>
      </nav>
    </aside>

    <main class="content">
      <div class="page-header">
        <div>
          <h1>Editar Produto</h1>
          <p>Atualize as informações do produto</p>
        </div>
        <a href="/admin/products" class="btn btn-secondary">Voltar</a>
      </div>

      <div class="card">
        <form action="/admin/products/<%= product.id %>/update" method="POST" enctype="multipart/form-data"
          class="form-grid">
          <div class="form-group full">
            <label for="name">Nome do produto</label>
            <input type="text" id="name" name="name" value="<%= product.name %>" placeholder="Ex.: Coca-Cola 2L"
              required>
          </div>

          <div class="form-group full">
            <label for="description">Descrição</label>
            <textarea id="description" name="description"
              placeholder="Ex.: Refrigerante sabor cola, garrafa 2 litros"><%= product.description || "" %></textarea>
          </div>

          <div class="form-group">
            <label for="price">Preço</label>
            <input type="number" id="price" name="price" min="0" step="0.01" value="<%= product.price %>"
              placeholder="Ex.: 8.99" required>
            <small class="field-help">Use ponto para centavos. Ex.: 10.50</small>
          </div>

          <div class="form-group">
            <label for="old_price">Preço antigo</label>
            <input type="number" id="old_price" name="old_price" min="0" step="0.01"
              value="<%= product.old_price ?? '' %>" placeholder="Ex.: 10.99">
            <small class="field-help">Preencha apenas se o produto estiver em oferta.</small>
          </div>

          <div class="form-group">
            <label for="is_offer">Oferta</label>
            <select id="is_offer" name="is_offer" required>
              <option value="false" <%=!product.is_offer ? "selected" : "" %>>Não</option>
              <option value="true" <%=product.is_offer ? "selected" : "" %>>Sim</option>
            </select>
          </div>

          <div class="form-group">
            <label for="is_active">Status no site</label>
            <select id="is_active" name="is_active" required>
              <option value="true" <%=product.is_active ? "selected" : "" %>>Ativo</option>
              <option value="false" <%=!product.is_active ? "selected" : "" %>>Inativo</option>
            </select>
          </div>

          <div class="form-group">
            <label for="stock">Estoque</label>
            <input type="number" id="stock" name="stock" min="0" step="1" value="<%= product.stock %>"
              placeholder="Ex.: 25" required>
            <small class="field-help">Digite apenas números inteiros.</small>
          </div>

          <div class="form-group">
            <label for="sector">Setor</label>
            <select id="sector" name="sector" required>
              <option value="">Selecione um setor</option>
              <option value="frios" <%=product.sector==="frios" ? "selected" : "" %>>Frios</option>
              <option value="carnes" <%=product.sector==="carnes" ? "selected" : "" %>>Carnes</option>
              <option value="bebidas" <%=product.sector==="bebidas" ? "selected" : "" %>>Bebidas</option>
              <option value="hortifruti" <%=product.sector==="hortifruti" ? "selected" : "" %>>Hortifruti</option>
              <option value="limpeza" <%=product.sector==="limpeza" ? "selected" : "" %>>Limpeza</option>
              <option value="padaria" <%=product.sector==="padaria" ? "selected" : "" %>>Padaria</option>
              <option value="higieneebeleza" <%=product.sector==="higieneebeleza" ? "selected" : "" %>>Higiene e beleza
              </option>
              <option value="biscoitosedoces" <%=product.sector==="biscoitosedoces" ? "selected" : "" %>>Biscoitos e
                doces</option>
              <option value="petshop" <%=product.sector==="petshop" ? "selected" : "" %>>Petshop</option>
              <option value="temperos" <%=product.sector==="temperos" ? "selected" : "" %>>Temperos</option>
              <option value="utilidades" <%=product.sector==="utilidades" ? "selected" : "" %>>Utilidades</option>
              <option value="congelados" <%=product.sector==="congelados" ? "selected" : "" %>>Congelados</option>
              <option value="basicos" <%=product.sector==="basicos" ? "selected" : "" %>>Básicos</option>
            </select>
          </div>

          <div class="form-group">
            <label for="category">Subcategoria</label>
            <select id="category" name="category" required data-selected="<%= product.category || '' %>">
              <option value="">Selecione um setor primeiro</option>
            </select>
          </div>

          <div class="form-group">
            <label for="image">Nova imagem do produto</label>
            <input type="file" id="image" name="image" accept=".jpg,.jpeg,.png,.webp">
            <small class="field-help">Envie uma nova imagem apenas se quiser substituir a atual.</small>
          </div>
          <div class="form-group full">
            <label>Prévia da imagem</label>
            <div class="image-preview-box">
              <% if (product.image_url) { %>
                <img id="imagePreview" src="<%= product.image_url %>" alt="Prévia da imagem">
                <p id="imagePreviewText" class="image-preview-text" style="display: none;">Nenhuma imagem informada.</p>
                <% } else { %>
                  <img id="imagePreview" src="" alt="Prévia da imagem" style="display: none;">
                  <p id="imagePreviewText" class="image-preview-text">Nenhuma imagem informada.</p>
                  <% } %>
            </div>
          </div>

          <div class="form-actions full">
            <button type="submit" class="btn">Atualizar Produto</button>
          </div>
        </form>
      </div>
    </main>
  </div>

<script src="/js/admin-product-form.js"></script>
</body>

</html>